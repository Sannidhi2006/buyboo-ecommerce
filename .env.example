# ==========================================
# E-Commerce Platform Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ecommerce_db

# JSON Web Token Secret
JWT_SECRET=supersecretjwtkey_ecommerce_2026_academic_production
JWT_EXPIRES_IN=7d

# Demo Admin Seed Configuration (Phase 3)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@ecommerce.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_PHONE=9999999999

# Frontend Client URL
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api

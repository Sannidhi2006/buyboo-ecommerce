# ==========================================
# E-Commerce Platform Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ecommerce_db

# JSON Web Token Secret
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Demo Admin Seed Configuration (Phase 3)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@ecommerce.local
SEED_ADMIN_PASSWORD=replace_with_a_strong_admin_password
SEED_ADMIN_PHONE=9999999999
SEED_SAMPLE_USER_PASSWORD=replace_with_a_strong_sample_password
SEED_SAMPLE_USER_ONE_USERNAME=demo_customer
SEED_SAMPLE_USER_ONE_EMAIL=demo.customer@example.com
SEED_SAMPLE_USER_ONE_PHONE=9000000001
SEED_SAMPLE_USER_TWO_USERNAME=demo_shopper
SEED_SAMPLE_USER_TWO_EMAIL=demo.shopper@example.com
SEED_SAMPLE_USER_TWO_PHONE=9000000002

# Frontend Client URL
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api
